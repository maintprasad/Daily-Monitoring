# ─────────────────────────────────────────────────────────────
# Salin file ini menjadi ".env" untuk testing lokal di XAMPP.
# File .env TIDAK ikut di-commit ke git.
# Di Vercel, isi variabel yang sama lewat:
#   Project → Settings → Environment Variables
# ─────────────────────────────────────────────────────────────

# Pilihan driver: sqlite | turso
# Kosongkan → otomatis "turso" jika TURSO_DATABASE_URL terisi, selain itu "sqlite".
DB_DRIVER=sqlite

# ── SQLite lokal (XAMPP) ──
# Path relatif terhadap root project. Folder database/ sudah dilindungi .htaccess.
SQLITE_PATH=database/dailymonitoring.db

# ── Turso (Vercel / production) ──
# Dapatkan dengan:  turso db show <nama-db> --url   dan   turso db tokens create <nama-db>
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ── Admin pertama (opsional) ──
# Jika diisi, admin ini otomatis dibuat saat tabel users masih kosong.
# Setelah admin terbuat, sebaiknya hapus nilai password ini.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_NAME=Administrator

APP_TIMEZONE=Asia/Jakarta
